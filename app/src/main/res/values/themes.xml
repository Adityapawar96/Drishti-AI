<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.DrishtiJava" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorPrimaryContainer">@color/color_surface_highlight</item>
        <item name="colorOnPrimaryContainer">@color/color_primary_dark</item>
        <item name="colorSecondary">@color/color_accent</item>
        <item name="colorOnSecondary">@color/color_on_accent</item>
        <item name="colorSecondaryContainer">@color/color_surface_blue</item>
        <item name="colorOnSecondaryContainer">@color/color_on_accent</item>
        <item name="colorTertiary">@color/color_highlight</item>
        <item name="colorOnTertiary">@color/color_on_highlight</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorSurfaceVariant">@color/color_surface_disabled</item>
        <item name="colorOnSurfaceVariant">@color/color_text_secondary</item>
        <item name="colorOnBackground">@color/color_text_primary</item>
        <item name="colorOutline">@color/color_outline_interactive</item>
        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/color_on_error</item>
        <item name="android:colorAccent">@color/color_primary</item>
        <item name="colorControlActivated">@color/color_primary</item>
        <item name="colorControlNormal">@color/color_primary_dark</item>
        <item name="android:colorControlActivated">@color/color_primary</item>
        <item name="android:colorControlHighlight">@color/focus_overlay</item>
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:navigationBarColor">@color/color_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="fontFamily">@font/baloo2</item>
        <item name="android:textViewStyle">@style/Widget.Drishti.TextView</item>
        <item name="android:buttonStyle">@style/Widget.Drishti.Button</item>
        <item name="materialButtonStyle">@style/Widget.Drishti.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Drishti.Button.Secondary</item>
        <item name="checkboxStyle">@style/Widget.Drishti.CheckBox</item>
        <item name="switchStyle">@style/Widget.Drishti.Switch</item>
        <item name="sliderStyle">@style/Widget.Drishti.Slider</item>
        <item name="textInputStyle">@style/Widget.Drishti.TextInputLayout</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Drishti.AlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Drishti.AlertDialog</item>
        <item name="snackbarStyle">@style/Widget.Drishti.Snackbar</item>
        <item name="buttonBarButtonStyle">@style/Widget.Drishti.Button.Text</item>
    </style>

    <style name="Theme.DrishtiJava" parent="Base.Theme.DrishtiJava" />

    <style name="ThemeOverlay.Drishti.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/color_primary_dark</item>
        <item name="android:colorAccent">@color/color_primary_dark</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="android:windowBackground">@color/color_surface</item>
    </style>

    <style name="Widget.Drishti.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/color_snackbar_background</item>
        <item name="android:textColor">@color/color_on_snackbar</item>
    </style>

    <style name="Widget.Drishti.TextView" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.Drishti.Button" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/button_primary_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">16dp</item>
        <item name="rippleColor">@color/focus_overlay</item>
    </style>

    <style name="Widget.Drishti.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/button_secondary_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="strokeColor">@color/color_outline</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">16dp</item>
        <item name="rippleColor">@color/focus_overlay</item>
    </style>

    <style name="Widget.Drishti.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:background">@drawable/button_text_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/button_text_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Drishti.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/control_check_tint</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="Widget.Drishti.Switch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="thumbTint">@color/control_thumb_tint</item>
        <item name="trackTint">@color/control_track_tint</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="Widget.Drishti.Slider" parent="Widget.Material3.Slider">
        <item name="trackColorActive">@color/color_primary</item>
        <item name="trackColorInactive">@color/color_outline</item>
        <item name="thumbColor">@color/color_primary</item>
        <item name="haloColor">@color/focus_overlay</item>
    </style>

    <style name="Widget.Drishti.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_underline_tint</item>
        <item name="boxBackgroundColor">@color/color_surface_disabled</item>
        <item name="hintTextColor">@color/color_text_secondary</item>
    </style>

    <style name="Widget.Drishti.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:background">@drawable/input_background</item>
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textColorHint">@color/color_text_secondary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">56dp</item>
    </style>
</resources>
