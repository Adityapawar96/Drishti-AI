<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.drishtijava.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="16dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="16dp" />

    <!-- Top Overlay Controls -->
    <LinearLayout
        android:id="@+id/topControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
        app:layout_constraintStart_toStartOf="@id/guidelineStart"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/camera_status_background"
                android:minHeight="56dp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="@string/camera_starting"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/home_button_background"
                android:contentDescription="@string/open_settings"
                android:minWidth="56dp"
                android:minHeight="56dp"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="@color/color_icon" />
        </LinearLayout>

        <TextView
            android:id="@+id/sceneAnalysisText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/camera_status_background"
            android:ellipsize="end"
            android:maxLines="6"
            android:padding="16dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom Overlay Controls in the bottom third -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/camera_controls_background"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
        app:layout_constraintStart_toStartOf="@id/guidelineStart">

        <TextView
            android:id="@+id/performanceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="40dp"
            android:padding="8dp"
            android:text="@string/performance_initial"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/detectionModeSegment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/objectsModeButton"
                    style="@style/Widget.Drishti.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/object_mode_selected"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="56dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/mode_objects_short"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_objects_selected"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/color_icon" />

                <Button
                    android:id="@+id/roadModeButton"
                    style="@style/Widget.Drishti.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/select_road_mode"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="56dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/mode_road_short"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_road"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/color_icon" />
            </LinearLayout>

            <Button
                android:id="@+id/pauseDetectionButton"
                style="@style/Widget.Drishti.Button"
                android:layout_width="100dp"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:minHeight="56dp"
                android:text="@string/pause"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/lightStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:minHeight="40dp"
            android:padding="8dp"
            android:text="@string/torch_unavailable"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/setupInstructionsBubble"
        style="@style/Widget.Drishti.Button"
        android:background="@drawable/button_bubble_background"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/setup_instructions_bubble_description"
        android:minWidth="60dp"
        android:minHeight="60dp"
        android:stateListAnimator="@null"
        android:text="@string/setup_help_icon"
        android:textSize="26sp"
        app:cornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.58" />

</androidx.constraintlayout.widget.ConstraintLayout>
