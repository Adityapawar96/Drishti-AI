<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/enrollmentPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <View
        android:layout_width="230dp"
        android:layout_height="290dp"
        android:layout_gravity="center"
        android:background="@drawable/enrollment_face_guide"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:background="@drawable/camera_status_background"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/enrollmentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-rounded"
            android:text="Add a known person"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/enrollmentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="polite"
            android:text="Preparing offline face recognition…"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/camera_controls_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <Button
            android:id="@+id/startEnrollmentButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/duo_green"
            android:minHeight="60dp"
            android:text="Start guided capture"
            android:textAllCaps="false"
            android:textColor="@color/duo_button_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/cancelEnrollmentButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/duo_pale_green"
            android:minHeight="56dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/duo_button_text"
            android:textSize="17sp" />
    </LinearLayout>
</FrameLayout>
