<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/duo_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/knownPeopleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-rounded"
            android:text="Known people"
            android:textColor="@color/duo_ink"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Recognize familiar people when they appear."
            android:textColor="@color/duo_muted"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/knownPeoplePrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/duo_info_card_background"
            android:padding="18dp"
            android:text="Your privacy matters: face profiles are encrypted on this device. Photos are not saved. Add someone only with their informed consent."
            android:textColor="@color/duo_button_text"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/personNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/duo_green_deep"
            android:hint="Person's name"
            android:inputType="textPersonName|textCapWords"
            android:minHeight="60dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:contentDescription="Enter the name to speak when this person appears"
            android:textColor="@color/duo_ink"
            android:textSize="18sp" />

        <Button
            android:id="@+id/addKnownPersonButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/duo_green"
            android:minHeight="60dp"
            android:text="Add a person"
            android:textAllCaps="false"
            android:textColor="@color/duo_button_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/duo_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/knownPeopleStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="sans-serif-rounded"
                android:text="Loading saved people…"
                android:textColor="@color/duo_ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/knownPeopleList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
