<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_disabled" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/color_outline" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_highlight" />
            <corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="@color/color_focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/color_outline_interactive" />
        </shape>
    </item>
</selector>
