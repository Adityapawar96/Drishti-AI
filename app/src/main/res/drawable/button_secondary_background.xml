<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_disabled" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_background" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="@color/color_focus_ring" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <inset android:insetTop="2dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/color_surface_highlight" />
                <corners android:radius="16dp" />
                <stroke android:width="2dp" android:color="@color/color_primary_dark" />
            </shape>
        </inset>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/color_primary_dark" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/color_background" />
                    <corners android:radius="16dp" />
                    <stroke android:width="2dp" android:color="@color/color_outline" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
